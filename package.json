{
  "name": "dnb-task-platform",
  "version": "0.1.0",
  "private": true,
  "description": "",
  "main": "index.js",
  "scripts": {
    "workspaces:list": "npm ls --workspaces --depth=0",
    "workspace:check-link": "test -L node_modules/@dnb/task-flow-core && test -e node_modules/@dnb/task-flow-core && echo 'task-flow-core symlink is valid'",
    "dev": "concurrently --kill-others-on-fail --names API,WEB --prefix-colors blue,magenta \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "npm run start:dev -w apps/api",
    "dev:web": "npm run dev -w apps/web",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "format": "npm run format --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:core:verbose": "npm test -w @dnb/task-flow-core -- --runInBand --verbose",
    "test:coverage": "npm run test:cov --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "concurrently": "10.0.5"
  }
}
