          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id", "value": "user-2" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nextAssignedUserId\": \"user-3\",\n  \"data\": {\n    \"branchName\": \"feature/customer-dashboard\"\n  }\n}" },
            "url": "{{baseUrl}}/tasks/{{developmentTaskId}}/next"
          }
        },
        {
          "name": "4. Next - distribution completed",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id", "value": "user-3" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"nextAssignedUserId\": \"user-4\",\n  \"data\": {\n    \"versionNumber\": \"1.0.0\"\n  }\n}" },
            "url": "{{baseUrl}}/tasks/{{developmentTaskId}}/next"
          }
        },
        {
          "name": "Back one status",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-user-id", "value": "user-4" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"previousAssignedUserId\": \"user-3\"\n}" },
            "url": "{{baseUrl}}/tasks/{{developmentTaskId}}/back"
          }
        },
        {
          "name": "Close Development task",
          "request": {
            "method": "POST",
            "header": [{ "key": "x-user-id", "value": "user-4" }],
            "url": "{{baseUrl}}/tasks/{{developmentTaskId}}/close"
          }
        }
      ]
    },
    {
      "name": "3 - Product Order",
      "item": [
        {
          "name": "1. Create Product Order task",
          "event": [{
            "listen": "test",
            "script": { "exec": [
              "if (pm.response.code === 201) {",
              "  pm.collectionVariables.set('productOrderTaskId', pm.response.json().id);",
              "}"
            ] }
          }],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"workflowKey\": \"product-order\",\n  \"assignedUserId\": \"user-1\",\n  \"data\": {\n    \"productName\": \"Office chairs\"\n  }\n}"
            },
            "url": "{{baseUrl}}/tasks"
          }
        },
        {
          "name": "2. Next - supplier bids received",
          "request": {
