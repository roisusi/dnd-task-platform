            "body": { "mode": "raw", "raw": "{\n  \"nextAssignedUserId\": \"user-2\",\n  \"data\": {\n    \"bids\": [\n      { \"supplierName\": \"Supplier A\", \"price\": 5000 },\n      { \"supplierName\": \"Supplier B\", \"price\": 4700 }\n    ]\n  }\n}" },
