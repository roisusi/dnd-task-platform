      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "currentUserId", "value": "user-1" },
    { "key": "currentTaskId", "value": "" },
    { "key": "procurementTaskId", "value": "" },
    { "key": "developmentTaskId", "value": "" },
    { "key": "productOrderTaskId", "value": "" }
  ]
}
