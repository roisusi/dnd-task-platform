            "body": { "mode": "raw", "raw": "{\n  \"nextAssignedUserId\": \"user-2\",\n  \"data\": {\n    \"specification\": \"Dashboard specification text\"\n  }\n}" },
            "url": "{{baseUrl}}/tasks/{{developmentTaskId}}/next"
          }
        },
        {
